# Grammora AI Gateway Environment Configuration

# Server Port
PORT=3001

# Primary AI Provider: "groq" | "gemini" | "mock"
# Default to "groq" when keys are provided; falls back to "mock" if no keys are set.
AI_PROVIDER=groq

# Groq API Configuration (Primary - Ultra-fast inference)
# Models: "qwen/qwen3.8-27b", "llama-3.3-70b-versatile", or "llama-3.1-8b-instant"
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration (Secondary / Backup Fallback)
# Models: "gemini-1.5-flash" or "gemini-2.0-flash-exp"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Operational Parameters
REQUEST_TIMEOUT_MS=12000
MAX_REQUESTS_PER_MINUTE=60
MAX_INPUT_CHARACTERS=4000
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*

